      "id": "r2",
      "behavior": "kmaudit briefing reports a nested namespace's audit state, read from its store.",
      "fails_when": "briefing fails or leaves the nested namespace out",
      "command": "uv run pytest packages/kmaudit/tests/test_briefing.py -k nested -q",
      "judgment": false
    },
    {
      "id": "r3",
      "behavior": "Read-only store URIs are built from the store's absolute path with Path.as_uri, so a repository path holding %, # or ? opens, including the legacy store copy, and a relative store path works too.",
      "fails_when": "a store under a path with %, # or ? fails to open or copy, or a relative path raises",
      "command": "uv run pytest packages/kmaudit/tests/test_namespaces.py packages/kmaudit/tests/test_claims_store.py -k uri -q",
      "judgment": false
    }
