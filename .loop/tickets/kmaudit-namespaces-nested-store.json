      "id": "r1",
      "behavior": "kmaudit namespaces --json lists a nested namespace (handbook/guides, whose store file is handbook%2Fguides.sqlite) with its section count, and a top-level one beside it, without an error.",
      "fails_when": "the command fails, leaves the nested namespace out, or reports its counts as 0 when its store holds a section",
      "command": "uv run pytest packages/kmaudit/tests/test_namespaces.py -k nested -q",
      "judgment": false
    },
