    {
      "id": "r1",
      "behavior": "scripts/release_paths.py's owns gives no package .loop/, .okf/, .claude/ or uv.lock; kmaudit owns packages/kmaudit/, kmctl packages/kmctl/ and every other path outside packages/; its command reads paths on stdin and exits 0 when the package owns any of them, else 1.",
      "fails_when": "a bookkeeping path counts for either package, a shipped path is not owned by its package, or the command's exit code disagrees with owns",
      "command": "uv run pytest tests/scripts/test_release_paths.py -q",
      "judgment": false
    },
    {
      "id": "r2",
      "behavior": "release_notes.py takes owns from release_paths.py: a commit touching only .okf/ and uv.lock is in neither package's notes, one touching .okf/ and packages/kmaudit/ is in kmaudit's, one touching .claude/ and docs/ is in kmctl's, and every earlier release_notes test passes.",
      "fails_when": "a bookkeeping-only commit is listed, a mixed commit is left out of its package's notes, or any release_notes test fails",
      "command": "uv run pytest tests/scripts/test_release_notes.py -q",
      "judgment": false
    },
    {
      "id": "r3",
      "behavior": "release-tag's late-commit step decides ownership by piping each late commit's paths to release_paths.py, holds no awk copy of the rule, does not name a late bookkeeping-only commit but names a late shipped one, and still never runs release_notes.py or --generate-notes.",
      "fails_when": "the step keeps an awk ownership rule, names a bookkeeping-only commit, misses a shipped one, or release-tag.yml names release_notes.py",
      "command": "uv run pytest tests/scripts/test_workflows.py -k release_tag -q",
      "judgment": false
    }
  ],
