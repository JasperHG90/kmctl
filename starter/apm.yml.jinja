# APM (Agent Package Manager) dependencies: skills, rules, hooks and MCP
# servers for the agent harnesses below. Install them with `just install`.
name: {{ project_name | lower | replace(' ', '-') }}
version: 0.1.0
dependencies:
  apm:
    # kmctl: knowledge skills, rules, the session briefing hook and okf's
    # MCP server. Keep the ref the same as the kmctl CLI (`just kmctl`).
{#- Releases after v0.12.2 keep kmctl's APM package in packages/kmctl/apm; older ones in apm. #}
{%- set kmctl_release = (kmctl_ref[1:] | regex_replace('(a|b|rc)[0-9]+$', '')).split('.') | map('int') | list %}
    - git: https://github.com/JasperHG90/kmctl.git
      path: {% if kmctl_release > [0, 12, 2] %}packages/kmctl/apm{% else %}apm{% endif %}
      ref: {{ kmctl_ref }}
{%- if adversarial_review and 'claude' in harnesses %}
    # The agent the adversarial-reviews rule in AGENTS.md hands each finished
    # task to (Claude Code only).
    - jasperhg90/skills/agents/adversarial-reviewer.agent.md#41f495021f3b264992c8fa764d58565c1184ab91
{%- endif %}
    # Add your own dependencies, and an mcp: block, below this line. just
    # upgrade rewrites the kmctl ref above, and content added directly below it
    # would conflict.
targets:
{%- for harness in harnesses %}
  - {{ harness }}
{%- endfor %}
