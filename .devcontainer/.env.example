# Variables passed to the container. Copy to .devcontainer/.env (git-ignored).
# The container starts without it: initializeCommand creates an empty one.

# Optional: authenticate Claude Code with an API key instead of `claude login`.
#ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: a token for gh and for pushing over HTTPS.
#GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
